<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <application android:allowBackup="false" android:icon="@drawable/ic_compositor" android:roundIcon="@drawable/ic_compositor" android:label="@string/app_name" android:theme="@style/AppTheme" android:supportsRtl="true" android:localeConfig="@xml/locales_config">
        <meta-data android:name="com.pojia.compositor.RELEASE_CHANNEL" android:value="${compositorReleaseChannel}" />
